# Telegram token from @BotFather
BOT_TOKEN=123456789:REPLACE_ME

# Required for webhook mode.
WEBHOOK_SECRET=change_me_to_a_long_random_value

# Optional outside Render. Render provides RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
PORT=10000

# Telegram MTProto credentials from https://my.telegram.org/apps
# Required for REAL .gift purchases from the connected user's Stars balance.
TG_API_ID=
TG_API_HASH=

# Optional. A persisted teleproto StringSession.
# Keep secret and NEVER commit a real value.
TG_MT_SESSION=

# Optional comma-separated Business Connection IDs to preload after restart.
KNOWN_BUSINESS_CONNECTION_IDS=
