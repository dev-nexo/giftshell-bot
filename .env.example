# Telegram token from @BotFather
BOT_TOKEN=123456789:REPLACE_ME

# Required for webhook mode. Render generates this automatically from render.yaml.
WEBHOOK_SECRET=change_me_to_a_long_random_value

# OPTIONAL outside Render. On Render this is NOT needed because RENDER_EXTERNAL_URL
# is injected automatically by the platform.
# Example: https://giftshell-bot.example.com
PUBLIC_URL=

# Render provides PORT automatically. 10000 is also Render's default.
PORT=10000
